//For surprisal table, use Rust crate wordfreq-model
FUNCTION SURPRISAL(tokenList AS LIST, probTable as DICT, defaultProb as FLOAT) 
	//Use shannon surprisal formula S(w) = -log2(P(w))

	SET surprisalScores AS LIST(EMPTY)

	FOR EACH tokenObj IN tokenList DO
		SET word = tokenObj.word
		SET prob = defaultProb //As baseline to increase if greater to prevent log(0) error

		IF word IN probTable THEN
			prob = probTable[word]
		END IF

		IF prob <=0 THEN
			prob = defaultProb
		ENDIF

		SET score = -1.0 * LOG2(prob)
		APPEND score TO surprisalScores
	ENDFOR

	RETURN surprisalScores AS LIST OF FLOAT

ENDFUNCTION

FUNCTION PRUNE_SURPRISAL(tokenList AS LIST, surprisalScores AS LIST, surprisalThreshold AS FLOAT, protectedSet AS SET)

	FOR i FROM 0 TO (LENGTH(tokenList)-1) DO
		SET tokenObj =tokenList[i]
		SET score = surprisalScores[i]
	
		IF tokenObj.word IN protectedSET THEN
			APPEND tokenObj TO survivingTokens
			CONTINUE //To avoid checks below
		ENDIF
	
		IF score >= surprisalThreshold THEN
			APPEND tokenObj TO survivingTokens
		END IF
	ENDFOR

	RETURN survivedTokens AS LIST
ENDFUNCTION

//Find centroid so that inputs are comparable for cosine similarity testing

FUNCTION COMPUTE_CENTROID(tokenList AS LIST, embeddingTABLE as Matrix, vectorDim AS INTEGER) 

	SET centroid = CREATE_ARRAY(vectorDim, 0.0)
	SET validTokens = 0

	FOR EACH tokenObj IN tokenList DO
		SET tokenVector = embeddingTable[tokenObj.id]
		FOR d from 0 TO (vectorDim - 1) DO
			centroid[d] = centroid[d] + tokenVector[d]
		ENDFOR
		validTokens = validTokens + 1
	ENDFOR

	//Divide by total count to get average coordinate
	IF validTokens > 0 THEN
		FOR d FROM 0 TO (vectorDim - 1) DO
			centroid[d] = centroid[d] / validTokens
		ENDFOR
	ENDIF

	RETURN centroid AS LIST OF FLOATS
ENDFUNCTION

FUNCTION COSINE_SIMILARITY(vectorA AS LIST OF FLOAT, vectorB AS LIST OF FLOAT, vectorDim AS INTEGER)

	SET dotProduct = 0.0
	SET normA = 0.0
	SET normB = 0.0

	FOR d FROM 0 TO (vectorDim - 1) DO
		dotProduct = dotProduct + (vectorA[d] * vectorB[d])
		normA = normA + (vectorA[d] * vectorA[d])
		normB = normB + (vectorB[d] * vectorB[d])
	ENDFOR

	SET magnitudeA = SQRT(normA)
	SET magnitudeB = SQRT(normB)

	//Prevent divide by zero error
	IF magnitudeA == 0.0 OR magnitude B == 0.0 THEN
		RETURN 0.0
	END IF

	RETURN dotProduct / (magnitudeA * magnitudeB) AS FLOAT
ENDFUNCTION

